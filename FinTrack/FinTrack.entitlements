<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the shared UserDefaults suite the Siri/Shortcuts intents,
	     widgets and Watch app all read and write ("group.com.fintrack.shared",
	     see WidgetDataService). Without this entitlement
	     UserDefaults(suiteName:) returns nil at runtime and every enqueue and
	     dequeue silently no-ops — an AppIntent appears to succeed while
	     storing nothing. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.fintrack.shared</string>
	</array>
</dict>
</plist>
